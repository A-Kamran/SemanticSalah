    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticstructuredactivity.com/ontology/Action"/>
            <rdf:Description rdf:about="http://www.semanticstructuredactivity.com/ontology/ActivitySegment"/>
            <rdf:Description rdf:about="http://www.semanticstructuredactivity.com/ontology/ActivityUnit"/>
        </owl:members>
    </rdf:Description>
</rdf:RDF>



