<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticstructuredactivity.com/ontology/"
     xml:base="http://www.semanticstructuredactivity.com/ontology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:sosa="http://www.w3.org/ns/sosa/"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:activity="http://www.semanticstructuredactivity.com/ontology/">
    <owl:Ontology rdf:about="http://www.semanticstructuredactivity.com/ontology">
        <owl:versionIRI rdf:resource="http://www.semanticstructuredactivity.com/ontology/1.2.0"/>
        <dcterms:creator>Amna Binte Kamran</dcterms:creator>
        <dcterms:description xml:lang="en">A lightweight core ontology for representing structured human activities, their components, ordering, observations, agents, and validation results.</dcterms:description>
        <dcterms:license>https://creativecommons.org/licenses/by-sa/4.0/</dcterms:license>
        <dcterms:title xml:lang="en">SemanticStructuredActivity Ontology</dcterms:title>
        <vann:preferredNamespacePrefix>activity</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://www.semanticstructuredactivity.com/ontology/</vann:preferredNamespaceUri>
        <owl:versionInfo>1.2.0</owl:versionInfo>
    </owl:Ontology>
    


