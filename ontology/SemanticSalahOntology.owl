        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/NonObligatorySalah"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <rdfs:comment xml:lang="en">Deprecated: sunnah rakahs around an obligatory prayer are modeled as a SalahUnit with hasSalahUnitType Sunnah inside that prayer (via hasSalahUnit), not as a separate Salah.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/TwoRakahPrayerAfterMaghrib -->

