        <rdfs:label xml:lang="en">Duha</rdfs:label>
        <rdfs:label xml:lang="ar">ضحى</rdfs:label>
        <rdfs:comment xml:lang="en">Voluntary mid-morning prayer. Number of rakahs is not fixed in this class.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/Tahajjud -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/Tahajjud">
