    <!-- http://www.semanticsalah.com/ontology/FourRakahPrayerBeforeZuhr -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/FourRakahPrayerBeforeZuhr">
        <rdfs:label xml:lang="en">Four rakah prayer before Zuhr (deprecated)</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/NonObligatorySalah"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <rdfs:comment xml:lang="en">Deprecated: sunnah rakahs around an obligatory prayer are modeled as a SalahUnit with hasSalahUnitType Sunnah inside that prayer (via hasSalahUnit), not as a separate Salah.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/FourSalahUnit -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/FourSalahUnit">
        <rdfs:label xml:lang="en">Four-rakah Salah unit</rdfs:label>
        <rdfs:comment xml:lang="en">Defined class: a Salah unit whose prescribed number of rakahs (hasUnitRakahCount) is 4.</rdfs:comment>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/hasUnitRakahCount"/>
