        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/ObligatorySalah"/>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/JalsaPosture -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/JalsaPosture">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/hasPostureType"/>
                <owl:hasValue rdf:resource="http://www.semanticsalah.com/ontology/JalsaType"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <terms:description xml:lang="en">Sitting or kneeling (Arabic: جِلسة and قعدة, also جلوس and قعود) is an integral part of salah, or Islamic prayer, along with bowing (ruku&apos; and sujud).</terms:description>
        <rdfs:label xml:lang="en">Jalsa</rdfs:label>
        <rdfs:label xml:lang="ar">جِلسة</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q7532085</rdfs:seeAlso>
        <owl:sameAs xml:lang="en">http://dbpedia.org/resource/Sitting_in_salah</owl:sameAs>
        <skos:altLabel xml:lang="en">Sitting in salah</skos:altLabel>
        <skos:altLabel xml:lang="ar">جلوس</skos:altLabel>
        <skos:altLabel xml:lang="ar">قعدة</skos:altLabel>
        <skos:altLabel xml:lang="ar">قعود</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/Late -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/Late">
        <rdfs:label xml:lang="en">Late</rdfs:label>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/isOnTime"/>
                <owl:hasValue rdf:resource="http://www.semanticsalah.com/ontology/Late"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Timeliness"/>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/Maghrib -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/Maghrib">
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/ObligatorySalah"/>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/NonObligatorySalah -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/NonObligatorySalah">
        <rdfs:label xml:lang="en">Non-obligatory Salah</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:comment xml:lang="en">Prayer-level classification: a non-obligatory Salah. Not a unit-level value; the non-obligatory status of a SalahUnit is expressed with hasSalahUnitType (value Sunnah).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/ObligatorySalah -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/ObligatorySalah">
        <rdfs:label xml:lang="en">Obligatory Salah</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:comment xml:lang="en">Prayer-level classification: an obligatory Salah. Not a unit-level value; the obligatory status of a SalahUnit is expressed with hasSalahUnitType (value Farz).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/OnTime -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/OnTime">
        <rdfs:label xml:lang="en">On time</rdfs:label>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/isOnTime"/>
                <owl:hasValue rdf:resource="http://www.semanticsalah.com/ontology/OnTime"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Timeliness"/>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/Posture -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/Posture">
        <rdfs:label xml:lang="en">Posture</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/Action"/>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/PostureType -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/PostureType">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">Posture Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/QayamPosture -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/QayamPosture">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/hasPostureType"/>
                <owl:hasValue rdf:resource="http://www.semanticsalah.com/ontology/QayamType"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <terms:description>The prayer begins in the standing position Qiyam.</terms:description>
        <rdfs:label xml:lang="en">Qayam</rdfs:label>
        <rdfs:label xml:lang="ar">قيام</rdfs:label>
        <rdfs:seeAlso>http://www.wikidata.org/entity/Q1392957</rdfs:seeAlso>
        <owl:sameAs>http://dbpedia.org/resource/Qiyam</owl:sameAs>
        <skos:altLabel xml:lang="en">Qiyam</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/QoumPosture -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/QoumPosture">
        <rdfs:label xml:lang="en">Qoum posture</rdfs:label>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/hasPostureType"/>
                <owl:hasValue rdf:resource="http://www.semanticsalah.com/ontology/QoumType"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/Rakah -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/Rakah">
        <rdfs:subClassOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/ActivityUnit"/>
        <terms:description xml:lang="en">A Rak&apos;ah (Arabic: ركعة rakʿah, pronounced [ˈrakʕah]; plural: ركعات rakaʿāt) is a single iteration of prescribed movements and supplications performed by Muslims as part of the prescribed obligatory prayer known as salah. Each of the five daily prayers observed by Muslims consists of a number of raka&apos;at</terms:description>
        <rdfs:label xml:lang="en">Rakah</rdfs:label>
        <rdfs:label xml:lang="ar">ركعة</rdfs:label>
        <owl:sameAs xml:lang="en">http://dbpedia.org/resource/Rak&apos;a</owl:sameAs>
        <owl:sameAs>https://www.wikidata.org/wiki/Q644359</owl:sameAs>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/RukuPosture -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/RukuPosture">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/hasPostureType"/>
                <owl:hasValue rdf:resource="http://www.semanticsalah.com/ontology/RukuType"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <terms:description xml:lang="en">In prayer, it refers to the bowing at the waist from standing (qiyām) on the completion of recitation (qiraʾat) of a portion of the Qur&apos;an in Islamic formal prayers (salah). There is a consensus on the obligatory nature of the rukūʿ. The position of rukūʿ is established by bending over till the hands are on the knees and remaining in that position until one attains a relaxed state while glorifying God (سُبْحَانَ رَبِّيَ الْعَظِيم subḥāna rabbiya l-ʿaẓīm, &quot;Glory be to my Lord, the Most Magnificent!&quot;) thrice or more in odd number of times.</terms:description>
        <rdfs:label xml:lang="en">Ruku</rdfs:label>
        <rdfs:label xml:lang="ar">رُكوع</rdfs:label>
        <rdfs:label xml:lang="ur">رُكوع</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q1816496</rdfs:seeAlso>
        <owl:sameAs xml:lang="en">http://dbpedia.org/resource/Ruku</owl:sameAs>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/SajdaPosture -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/SajdaPosture">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/hasPostureType"/>
                <owl:hasValue rdf:resource="http://www.semanticsalah.com/ontology/SajdaType"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <terms:description xml:lang="en">Sujūd (Arabic: سُجود, [sʊˈdʒuːd]), or sajdah (سجدة, pronounced [ˈsadʒda(tu)]), is the act of low bowing or prostration to God facing the qiblah (direction of the Kaaba at Mecca). It is usually done in standardized prayers (salah). The position involves kneeling and bowing till one touches the ground with the forehead, nose, palms, knees and toes, and remaining in that position until one attains a relaxed state while glorifying God (سُبْحَانَ رَبِّيَ الْأعْلَى subḥāna rabbiya l-ʾaʿlā, &quot;Glory be to my Lord, the Most High!&quot;) thrice or more in odd number of times.</terms:description>
        <rdfs:label xml:lang="en">Sujud</rdfs:label>
        <rdfs:label xml:lang="en">sajdah</rdfs:label>
        <rdfs:label xml:lang="ar">سجدة</rdfs:label>
        <rdfs:label xml:lang="ur">سجدة</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q929831</rdfs:seeAlso>
        <owl:sameAs xml:lang="en">http://dbpedia.org/resource/Sujud</owl:sameAs>
        <skos:altLabel xml:lang="ar">سُجود</skos:altLabel>
        <skos:altLabel xml:lang="ur">سُجود</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/Salah -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/Salah">
        <rdfs:subClassOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/StructuredActivity"/>
        <terms:description xml:lang="en">Salah (Arabic: صَلاة lit. &apos;prayer&apos;), also known as namāz (Persian: نماز) and also spelled salat, are prayers performed by Muslims. Facing the qibla, the direction of the Kaaba with respect to those praying, Muslims pray first standing and later kneeling or sitting on the ground, reciting prescribed prayers and phrases from the Quran as they bow and prostrate themselves in between. Salah is composed of prescribed repetitive cycles of bows and prostrations, called rakat (sing. rak&apos;ah). The number of rak&apos;ahs, also known as units of prayer, varies from prayer to prayer. Ritual purity and wudu are prerequisites for performing the prayers. The daily obligatory prayers collectively form the second of the five pillars in Islam, observed three or five times (the latter being the majority) every day at prescribed times. These are usually Fajr (observed at dawn), Zuhr (observed at noon), Asr (observed late in the afternoon), Maghrib (observed after sunset), and Isha (observed at dusk). Salah can be performed either in solitude, or collectively (known as jama&apos;ah). When performed in jama&apos;ah, worshippers line up in parallel rows behind a leader, known as the imam. Special prayers are exclusively performed in congregation, such as the Friday prayer and the Eid prayers, and are coupled with two sermons each, delivered by the imam.</terms:description>
        <rdfs:label xml:lang="ar">صَلاة</rdfs:label>
        <rdfs:label xml:lang="fa">نماز</rdfs:label>
        <rdfs:label xml:lang="ur">نماز</rdfs:label>
        <owl:sameAs>https://dbpedia.org/page/Salah</owl:sameAs>
        <owl:sameAs>https://www.wikidata.org/wiki/Q234869</owl:sameAs>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/SalahStatus -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/SalahStatus">
        <rdfs:label xml:lang="en">Salah status</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/SalahTimeWindow -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/SalahTimeWindow">
        <rdfs:label xml:lang="en">Salah time window</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <terms:description xml:lang="en">To be considered valid salat, the formal daily prayers must each be performed within their own prescribed time period. People with a legitimate reason have a longer period during which their prayers will be valid.</terms:description>
        <owl:sameAs xml:lang="en">http://dbpedia.org/resource/Salah_times</owl:sameAs>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/SalahType -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/SalahType">
        <rdfs:label xml:lang="en">Salah type</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:sameAs>https://www.wikidata.org/wiki/Q4110717</owl:sameAs>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/SalahUnit -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/SalahUnit">
        <rdfs:label xml:lang="en">Salah unit</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/ActivitySegment"/>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/SalahUnitType -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/SalahUnitType">
        <rdfs:label xml:lang="en">Salah unit type</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/TashahudPosture -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/TashahudPosture">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/hasPostureType"/>
                <owl:hasValue rdf:resource="http://www.semanticsalah.com/ontology/TashahudType"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <terms:description xml:lang="en">The Tashahhud (Arabic: تَشَهُّد, meaning &quot;testimony [of faith]&quot;), also known as at-Tahiyyat (Arabic: ٱلتَّحِيَّات, lit. &apos;greetings&apos;), is the portion of the Muslim prayer where the person kneels or sits on the ground facing the qibla, glorifies God, and greets the messenger and the righteous people of God followed by the two testimonials. The recitation is usually followed by an invocation of the blessings and peace upon the prophet known as Salawat.</terms:description>
        <rdfs:label xml:lang="en">Tashahhud</rdfs:label>
        <rdfs:label xml:lang="ar">تَشَهُّد</rdfs:label>
        <rdfs:seeAlso>https://www.wikidata.org/wiki/Q4115852</rdfs:seeAlso>
        <owl:sameAs xml:lang="en">http://dbpedia.org/resource/Tashahhud</owl:sameAs>
        <skos:altLabel xml:lang="en">at-Tahiyyat</skos:altLabel>
        <skos:altLabel xml:lang="ar">ٱلتَّحِيَّات</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/ThreeSalahUnit -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/ThreeSalahUnit">
        <rdfs:label xml:lang="en">Three-rakah Salah unit</rdfs:label>
        <rdfs:comment xml:lang="en">Defined class: a Salah unit whose prescribed number of rakahs (hasUnitRakahCount) is 3.</rdfs:comment>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/hasUnitRakahCount"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/SalahUnit"/>
    </owl:Class>
    


