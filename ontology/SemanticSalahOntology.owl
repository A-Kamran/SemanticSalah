    </owl:Class>
    


    <!-- http://www.semanticsalah.com/ontology/TwoSalahUnit -->

    <owl:Class rdf:about="http://www.semanticsalah.com/ontology/TwoSalahUnit">
        <rdfs:label xml:lang="en">Two-rakah Salah unit</rdfs:label>
