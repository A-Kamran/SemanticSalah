<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticsalah.com/"
     xml:base="http://www.semanticsalah.com/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:owlr="http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:ontology="http://www.semanticsalah.com/ontology/">
    <owl:Ontology rdf:about="http://www.semanticsalah.com">
        <terms:creator>Amna Basharat</terms:creator>
        <terms:creator>Amna Binte Kamran</terms:creator>
        <terms:description xml:lang="en">The Semantic Salah Ontology is a formal knowledge model designed to encapsulate the components of Salah, ranging from the foundational prayer units (rakahs) to the temporal considerations governing the timing of Salah.</terms:description>
        <terms:description xml:lang="en">This ontology aligns its top-level classes and ordering/containment properties with the SemanticStructuredActivity Ontology (http://www.semanticstructuredactivity.com/ontology/): Salah as StructuredActivity, SalahUnit as ActivitySegment, Rakah as ActivityUnit, and Postures as Action. The SemanticStructuredActivity terms referenced here are re-declared locally as bare stubs so this file is usable on its own; loading it alongside the actual SemanticStructuredActivity ontology brings in its full axiomatisation (disjointness, hasValidationResult, etc.) as well.</terms:description>
        <terms:license>https://creativecommons.org/licenses/by-sa/4.0/</terms:license>
        <terms:title>The Semantic Salah Ontology</terms:title>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <owl:versionIRI rdf:resource="http://www.semanticsalah.com/1.0.0"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-09</terms:modified>
        <skos:changeNote xml:lang="en">Version 1.0.0. Prayer-level obligation (ObligatorySalah, NonObligatorySalah) is separated from unit-level obligation (hasSalahUnitType with Farz and Sunnah); hasSalahUnit is a sub-property of hasDirectComponent; the complete and incomplete rakah definitions are closed with posture counts and CompleteRakah and InCompleteRakah are disjoint; complete rakahs that are followed directly by standing accept an optional short sitting (Jalsa2); IncompleteSalahUnit, Duha, Tahajjud and Tarawih are added; the example prayers are typed with their prayer classes.</skos:changeNote>
        <vann:preferredNamespacePrefix>salah</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://www.semanticsalah.com/ontology/</vann:preferredNamespaceUri>
        <rdfs:isDefinedBy xml:lang="en">salah</rdfs:isDefinedBy>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#defined_class -->

    <owl:AnnotationProperty rdf:about="http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#defined_class"/>
    


    <!-- http://www.w3.org/2002/07/owl#equivalentClass -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#equivalentClass"/>
    


    <!-- http://www.w3.org/2002/07/owl#equivalentProperty -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#equivalentProperty"/>
    


    <!-- http://www.w3.org/2002/07/owl#sameAs -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#sameAs"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://schema.org/hasPart -->

    <owl:ObjectProperty rdf:about="http://schema.org/hasPart"/>
    


    <!-- http://schema.org/isPartOf -->

    <owl:ObjectProperty rdf:about="http://schema.org/isPartOf"/>
    


    <!-- http://www.semanticsalah.com/ontology/belongsToUnit -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/belongsToUnit">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/isPartOf"/>
        <owl:inverseOf rdf:resource="http://www.semanticsalah.com/ontology/containsRakah"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Rakah"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/SalahUnit"/>
        <rdfs:label>Belongs to Unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/containsPosture -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/containsPosture">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/hasPart"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/hasDirectComponent"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Rakah"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <rdfs:label>Contains Posture</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/containsRakah -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/containsRakah">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/hasPart"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/hasDirectComponent"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/SalahUnit"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/Rakah"/>
        <rdfs:label>Contains Rakah</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/followedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/followedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/directlyPrecedes"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <rdfs:label>Followed By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasCompletionStatus -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/hasCompletionStatus">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/SalahStatus"/>
        <rdfs:label>Has Completion Status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasExtraRakah -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/hasExtraRakah">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/SalahUnit"/>
        <rdfs:label>has Extra Rakah</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasMissedPosture -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/hasMissedPosture">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Rakah"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/PostureType"/>
        <rdfs:label>Has Missed Postures</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasMissedRakah -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/hasMissedRakah">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/SalahUnit"/>
        <rdfs:label>has Missed Rakah</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasPostureType -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/hasPostureType">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/PostureType"/>
        <rdfs:label>Has PostureType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasPrescribedWindow -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/hasPrescribedWindow">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/SalahTimeWindow"/>
        <rdfs:label>Has Prescribes Window</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasSalahType -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/hasSalahType">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/SalahType"/>
        <rdfs:label>Has Salah Type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasSalahUnit -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/hasSalahUnit">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/hasDirectComponent"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/SalahUnit"/>
        <rdfs:label>Has Salah unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasSalahUnitType -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/hasSalahUnitType">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/SalahUnit"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/SalahUnitType"/>
        <rdfs:comment xml:lang="en">Unit-level obligation classification of a SalahUnit: value is Farz or Sunnah. Structural classes (TwoSalahUnit, ThreeSalahUnit, FourSalahUnit) are separate and based on rakah count.</rdfs:comment>
        <rdfs:label>Has Salah unit Type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasStartingPosture -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/hasStartingPosture">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Rakah"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <rdfs:label>Has Starting Posture</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasStartingRakah -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/hasStartingRakah">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/Rakah"/>
        <rdfs:label>Has Starting Rakah</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/isOnTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/isOnTime">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/Timeliness"/>
        <rdfs:label>On Time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/isPerformedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/isPerformedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
        <owl:inverseOf rdf:resource="http://www.semanticsalah.com/ontology/performs"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:range rdf:resource="http://schema.org/Person"/>
        <rdfs:label>Observed by</rdfs:label>
        <rdfs:label>Performed by</rdfs:label>
        <owl:equivalentProperty>http://dbpedia.org/property/observedBy</owl:equivalentProperty>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/performs -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/performs">
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:label>Performs</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticsalah.com/ontology/rakahFollowedByRakah -->

    <owl:ObjectProperty rdf:about="http://www.semanticsalah.com/ontology/rakahFollowedByRakah">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/directlyPrecedes"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Rakah"/>
        <rdfs:range rdf:resource="http://www.semanticsalah.com/ontology/Rakah"/>
        <rdfs:label>Rakah Followed By Rakah</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticstructuredactivity.com/ontology/directlyPrecedes -->

    <owl:ObjectProperty rdf:about="http://www.semanticstructuredactivity.com/ontology/directlyPrecedes"/>
    


    <!-- http://www.semanticstructuredactivity.com/ontology/hasDirectComponent -->

    <owl:ObjectProperty rdf:about="http://www.semanticstructuredactivity.com/ontology/hasDirectComponent"/>
    


    <!-- http://www.w3.org/ns/prov#wasAssociatedWith -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticsalah.com/ontology/hasPostureCount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/hasPostureCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Rakah"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>Has Posture Count</rdfs:label>
        <rdfs:comment xml:lang="en">Number of postures recorded in a rakah, asserted from the data. It lets patterns such as a rakah that stopped early be recognised without relying on the absence of further postures (OWL open-world assumption).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasRecordedRakahCount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/hasRecordedRakahCount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/SalahUnit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>Has Recorded Rakah Count</rdfs:label>
        <rdfs:comment xml:lang="en">Number of rakahs actually recorded in a unit, asserted from the data. Compared with hasUnitRakahCount (the prescribed number) it lets a unit with missing rakahs be recognised without relying on the absence of further rakahs (OWL open-world assumption).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasRakahNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/hasRakahNumber">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Rakah"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>Has Rakah Number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasRakahStatus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/hasRakahStatus">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Rakah"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>Has Rakah Status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasSalahUnitStatus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/hasSalahUnitStatus">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/SalahUnit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>Has Salah Unit Status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasUnitRakahCount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/hasUnitRakahCount">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/SalahUnit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>Has Unit Rakah count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasWindowEndTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/hasWindowEndTime">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/SalahTimeWindow"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Every Prayer has a prescribed window of time. This window end time indicates the time after which the Prayer observed will be considered late</rdfs:comment>
        <rdfs:label>Has Window End Time</rdfs:label>
        <owl:equivalentProperty>http://dbpedia.org/property/ends</owl:equivalentProperty>
        <owl:equivalentProperty>https://schema.org/endTime</owl:equivalentProperty>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/hasWindowStartTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/hasWindowStartTime">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/SalahTimeWindow"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Every Prayer has a prescribed window of time. This window start time indicates the time after which the Prayer can be observed</rdfs:comment>
        <rdfs:label>Has Window Start Time</rdfs:label>
        <owl:equivalentProperty>http://dbpedia.org/property/starts</owl:equivalentProperty>
        <owl:equivalentProperty>https://schema.org/startTime</owl:equivalentProperty>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/isCompletedAtTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/isCompletedAtTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/hasEndTime"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Range changed from xsd:string to xsd:dateTime to align with hasEndTime (SemanticStructuredActivity). No existing data used this property (0 asserted values), so no literal reformatting was needed.</rdfs:comment>
        <rdfs:comment>This is the time captured by the sensors that the person completed their prayer that they were observing</rdfs:comment>
        <rdfs:label>Is Completed at Time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/isStartedAtTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/isStartedAtTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/hasStartTime"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Range changed from xsd:string to xsd:dateTime to align with hasStartTime (SemanticStructuredActivity). No existing data used this property (0 asserted values), so no literal reformatting was needed.</rdfs:comment>
        <rdfs:comment>This is the time captured by the sensors that the person started their prayer that they were observing</rdfs:comment>
        <rdfs:label>Is started at Time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/performedInLocation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/performedInLocation">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Location the Salah/Prayer is observed at</rdfs:comment>
        <rdfs:label>Performed In Location</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/postureEndsAtTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/postureEndsAtTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/hasEndTime"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Range changed from xsd:string to xsd:dateTime to align with hasEndTime (SemanticStructuredActivity). No existing data used this property (0 asserted values), so no literal reformatting was needed.</rdfs:comment>
        <rdfs:label>Posture Ends at time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/postureStartsAtTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/postureStartsAtTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/hasStartTime"/>
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Range changed from xsd:string to xsd:dateTime to align with hasStartTime (SemanticStructuredActivity). The 32 existing literal values were reformatted from &quot;YYYY-MM-DD HH:MM:SS:mmm&quot; (not valid xsd:dateTime lexical form) to &quot;YYYY-MM-DDTHH:MM:SS.mmm&quot;, and stray leading whitespace was stripped.</rdfs:comment>
        <rdfs:label>Posture Starts at time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticsalah.com/ontology/rakahCount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticsalah.com/ontology/rakahCount">
        <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
