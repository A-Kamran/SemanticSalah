                                                                    <owl:Restriction>
                                                                        <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/followedBy"/>
                                                                        <owl:someValuesFrom>
                                                                            <owl:Class>
                                                                                <owl:intersectionOf rdf:parseType="Collection">
                                                                                    <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/SajdaPosture"/>
                                                                                    <owl:Restriction>
                                                                                        <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/followedBy"/>
                                                                                        <owl:someValuesFrom>
                                                                                            <owl:Class>
                                                                                                <owl:intersectionOf rdf:parseType="Collection">
                                                                                                    <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/JalsaPosture"/>
