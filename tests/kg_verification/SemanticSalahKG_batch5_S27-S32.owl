  <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/SajdaPosture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N54d21093d24f43e4b9899a2b97f4403c"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
    <dcterms:description xml:lang="en">Sujūd (Arabic: سُجود, [sʊˈdʒuːd]), or sajdah (سجدة, pronounced [ˈsadʒda(tu)]), is the act of low bowing or prostration to God facing the qiblah (direction of the Kaaba at Mecca). It is usually done in standardized prayers (salah). The position involves kneeling and bowing till one touches the ground with the forehead, nose, palms, knees and toes, and remaining in that position until one attains a relaxed state while glorifying God (سُبْحَانَ رَبِّيَ الْأعْلَى subḥāna rabbiya l-ʾaʿlā, "Glory be to my Lord, the Most High!") thrice or more in odd number of times.</dcterms:description>
    <rdfs:label xml:lang="en">Sujud</rdfs:label>
    <rdfs:label xml:lang="en">sajdah</rdfs:label>
    <rdfs:label xml:lang="ar">سجدة</rdfs:label>
    <rdfs:label xml:lang="ur">سجدة</rdfs:label>
    <rdfs:seeAlso>https://www.wikidata.org/wiki/Q929831</rdfs:seeAlso>
    <owl:sameAs xml:lang="en">http://dbpedia.org/resource/Sujud</owl:sameAs>
    <skos:altLabel xml:lang="ar">سُجود</skos:altLabel>
    <skos:altLabel xml:lang="ur">سُجود</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/S27_FZ_Rakah1_P3">
    <ontology:hasPostureType rdf:resource="http://www.semanticsalah.com/ontology/QoumType"/>
