  <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/SalahTimeWindow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Salah time window</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <dcterms:description xml:lang="en">To be considered valid salat, the formal daily prayers must each be performed within their own prescribed time period. People with a legitimate reason have a longer period during which their prayers will be valid.</dcterms:description>
    <owl:sameAs xml:lang="en">http://dbpedia.org/resource/Salah_times</owl:sameAs>
  </rdf:Description>
