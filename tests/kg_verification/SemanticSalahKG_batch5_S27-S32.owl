  <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/IncompletedFourUnitRakah4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Incomplete rakah 4 of a four-rakah unit</rdfs:label>
    <rdfs:comment xml:lang="en">Defined class (inferred by a reasoner): rakah number 4 of a four-rakah Salah unit that matches one of the observed incomplete patterns (a skipped, repeated or missing posture, or a rakah that stopped early). See the rule catalog.</rdfs:comment>
