  <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/IncompletedThreeUnitRakah2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Incomplete rakah 2 of a three-rakah unit</rdfs:label>
    <rdfs:comment xml:lang="en">Defined class (inferred by a reasoner): rakah number 2 of a three-rakah Salah unit that matches one of the observed incomplete patterns (a skipped, repeated or missing posture, or a rakah that stopped early). See the rule catalog.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="N7c692ce2c7fa4e21bc520bd9a511b3e8"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/InCompleteRakah"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/hasSalahUnitType">
