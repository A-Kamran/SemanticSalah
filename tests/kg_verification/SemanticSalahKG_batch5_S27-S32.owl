  <rdf:Description rdf:about="http://www.semanticsalah.com">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:creator>Amna Basharat</dcterms:creator>
    <dcterms:creator>Amna Binte Kamran</dcterms:creator>
    <dcterms:description xml:lang="en">The Semantic Salah Ontology is a formal knowledge model designed to encapsulate the components of Salah, ranging from the foundational prayer units (rakahs) to the temporal considerations governing the timing of Salah.</dcterms:description>
    <dcterms:description xml:lang="en">This ontology aligns its top-level classes and ordering/containment properties with the SemanticStructuredActivity Ontology (http://www.semanticstructuredactivity.com/ontology/): Salah as StructuredActivity, SalahUnit as ActivitySegment, Rakah as ActivityUnit, and Postures as Action. The SemanticStructuredActivity terms referenced here are re-declared locally as bare stubs so this file is usable on its own; loading it alongside the actual SemanticStructuredActivity ontology brings in its full axiomatisation (disjointness, hasValidationResult, etc.) as well.</dcterms:description>
    <dcterms:license>https://creativecommons.org/licenses/by-sa/4.0/</dcterms:license>
    <dcterms:title>The Semantic Salah Ontology with the knowledge graph (batch 5: S27 to S32)</dcterms:title>
    <owl:versionInfo>1.0.0 (knowledge graph verification file)</owl:versionInfo>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-09</dcterms:modified>
    <skos:changeNote xml:lang="en">Version 1.0.0. Prayer-level obligation (ObligatorySalah, NonObligatorySalah) is separated from unit-level obligation (hasSalahUnitType with Farz and Sunnah); hasSalahUnit is a sub-property of hasDirectComponent; the complete and incomplete rakah definitions are closed with posture counts and CompleteRakah and InCompleteRakah are disjoint; complete rakahs that are followed directly by standing accept an optional short sitting (Jalsa2); IncompleteSalahUnit, Duha, Tahajjud and Tarawih are added; the example prayers are typed with their prayer classes.</skos:changeNote>
    <vann:preferredNamespacePrefix>salah</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://www.semanticsalah.com/ontology/</vann:preferredNamespaceUri>
    <rdfs:isDefinedBy xml:lang="en">salah</rdfs:isDefinedBy>
  </rdf:Description>
