    <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/Posture"/>
    <dcterms:description xml:lang="en">Sitting or kneeling (Arabic: جِلسة and قعدة, also جلوس and قعود) is an integral part of salah, or Islamic prayer, along with bowing (ruku' and sujud).</dcterms:description>
    <rdfs:label xml:lang="en">Jalsa</rdfs:label>
    <rdfs:label xml:lang="ar">جِلسة</rdfs:label>
    <rdfs:seeAlso>https://www.wikidata.org/wiki/Q7532085</rdfs:seeAlso>
    <owl:sameAs xml:lang="en">http://dbpedia.org/resource/Sitting_in_salah</owl:sameAs>
    <skos:altLabel xml:lang="en">Sitting in salah</skos:altLabel>
    <skos:altLabel xml:lang="ar">جلوس</skos:altLabel>
    <skos:altLabel xml:lang="ar">قعدة</skos:altLabel>
    <skos:altLabel xml:lang="ar">قعود</skos:altLabel>
  </rdf:Description>
