  <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/isCompletedAtTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/hasEndTime"/>
    <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">Range changed from xsd:string to xsd:dateTime to align with hasEndTime (SemanticStructuredActivity). No existing data used this property (0 asserted values), so no literal reformatting was needed.</rdfs:comment>
