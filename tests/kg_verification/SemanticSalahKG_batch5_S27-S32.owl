  <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/isStartedAtTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticstructuredactivity.com/ontology/hasStartTime"/>
    <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/Salah"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">Range changed from xsd:string to xsd:dateTime to align with hasStartTime (SemanticStructuredActivity). No existing data used this property (0 asserted values), so no literal reformatting was needed.</rdfs:comment>
    <rdfs:comment>This is the time captured by the sensors that the person started their prayer that they were observing</rdfs:comment>
    <rdfs:label>Is started at Time</rdfs:label>
  </rdf:Description>
