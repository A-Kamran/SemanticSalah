  <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/hasRecordedRakahCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticsalah.com/ontology/SalahUnit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>Has Recorded Rakah Count</rdfs:label>
    <rdfs:comment xml:lang="en">Number of rakahs actually recorded in a unit, asserted from the data. Compared with hasUnitRakahCount (the prescribed number) it lets a unit with missing rakahs be recognised without relying on the absence of further rakahs (OWL open-world assumption).</rdfs:comment>
  </rdf:Description>
