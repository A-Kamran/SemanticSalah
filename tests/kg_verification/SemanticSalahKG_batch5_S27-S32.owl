    <owl:someValuesFrom rdf:nodeID="Nb6eb99a788ae4c958841beed0c67052d"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N69d009d3b3c14bfea5c845b6bf9dbeea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticsalah.com/ontology/hasUnitRakahCount"/>
