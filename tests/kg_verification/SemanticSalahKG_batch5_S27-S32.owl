  <rdf:Description rdf:about="http://www.semanticsalah.com/ontology/IncompletedTwoUnitRakah2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Incomplete rakah 2 of a two-rakah unit</rdfs:label>
    <rdfs:comment xml:lang="en">Defined class (inferred by a reasoner): rakah number 2 of a two-rakah Salah unit that matches one of the observed incomplete patterns (a skipped, repeated or missing posture, or a rakah that stopped early). See the rule catalog.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="Nb5ce259c9697499eb88d0413a4a28a3a"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticsalah.com/ontology/InCompleteRakah"/>
  </rdf:Description>
